function [theta_R_C, theta_R_R,  hat_psi_G] = R_est_sym_loc_G(x, theta_star, pert)

[Delta_G, psi_G_R] = eff_cent_seq_G(x, theta_star);

h = pert*randn(1);
n = length(x);

[Delta_G_h, ~]= eff_cent_seq_G(x, theta_star + h/sqrt(n));

hat_psi_G = abs(Delta_G_h - Delta_G)/abs(h); 

if hat_psi_G < 0.001
    hat_psi_G = psi_G_R;
end

% Consistent estimator
theta_R_C = theta_star + (1/sqrt(n)) * Delta_G / hat_psi_G;

% Robust estimator
theta_R_R = theta_star + (1/sqrt(n)) * Delta_G / psi_G_R;

end